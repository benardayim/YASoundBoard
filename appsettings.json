{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "YasoundBoard": {

    "Audio": {
      "DeviceNameMatch": "",
      "DeviceNameFallbacks": [],
      "SampleRate": 48000,
      "Channels": 2,
      "LatencyMs": 20,
      "ShareMode": "Shared",
      "FallBackToShared": true,
      "LowLatency": true,
      "LowLatencyRequired": false,
      "UseEventSync": true,
      "MmcssThreadPriority": "Pro Audio",
      "RawMode": false,
      "Category": "Media",
      "MaxVoices": 64,
      "MasterGain": 1.0,
      "SoftClip": true,
      "HeadroomSeconds": 1
    },

    "Library": {
      "SoundsDirectory": "sounds",
      "Recurse": true,
      "Extensions": [
        ".wav", ".wave", ".mp3", ".flac", ".ogg", ".oga", ".opus",
        ".m4a", ".mp4", ".aac", ".aif", ".aiff", ".wma", ".webm"
      ],
      "FfmpegPath": "ffmpeg",
      "MaxDecodeSeconds": 600,
      "ParallelDecodes": 4,
      "CacheDirectory": ".cache/pcm",
      "UseCache": true,
      "PruneCache": false,
      "MetadataFile": "sounds.json",
      "DefaultGain": 1.0,
      "Sort": "name"
    },

    "Server": {
      "BindAddress": "0.0.0.0",
      "Port": 8787,
      "AnnounceAddresses": true,
      "LogRequests": false
    },

    "Ui": {
      "Title": "yasoundboard",
      "DisplayMode": "standalone",
      "Theme": "auto",
      "AccentColor": "#e24b4a",
      "Columns": 0,
      "ShowLabels": true,
      "ShowLevels": true,
      "ShowStopAll": true,
      "ShowMasterVolume": true,
      "ShowConnectionStatus": true,
      "VibrateOnTap": true,
      "VibrateMs": 15,
      "FlashOnTap": true,
      "KeepAwake": true,
      "StateUpdatesPerSecond": 20,
      "PadMinWidthPx": 92,
      "PadGapPx": 8,
      "PadRadiusPx": 14
    }
  }
}
